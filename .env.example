# Copy to .env for local dev (never commit .env)
QUARKUS_DATASOURCE_USERNAME=postgres
QUARKUS_DATASOURCE_PASSWORD=your-local-password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ispautomation
JWT_SECRET=change-me-local-dev-only
GOOGLE_CLIENT_ID=your-google-client-id
CORS_ORIGINS=http://localhost:4900,http://127.0.0.1:4900
# Optional Upstash Redis (rediss://...)
REDIS_URL=
